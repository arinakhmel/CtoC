# Copy to .env once: cp .env.example .env
# The same file is read by apps/api (Node, Prisma) and apps/web (Vite, only VITE_* values).

# --- API ---
PORT=3001
# Path is relative to apps/api/prisma/. connection_limit=1 serialises writes (ADR-0004, ADR-0007).
DATABASE_URL="file:../data/ctoc.db?connection_limit=1"
# Base URL of the web app, used in the link inside confirmation emails (default: http://localhost:5173)
# In production it MUST equal the public https origin (e.g. https://your-app.up.railway.app), otherwise
# state-changing requests fail with ORIGIN_MISMATCH.
# APP_URL=http://localhost:5173
# Where uploaded student documents are stored, relative to apps/api (default: data/uploads, git-ignored)
# Production (Railway volume mounted at /data): UPLOAD_DIR=/data/uploads
# UPLOAD_DIR=data/uploads
# Built web app served by the API (optional, default: ../web/dist relative to apps/api)
# WEB_DIST_PATH=../web/dist
# Production (Railway): NODE_ENV=production and DATABASE_URL=file:/data/ctoc.db?connection_limit=1 (set in the
# Railway Variables, not here: variables that are already set win over this file). Do not set PORT there.
# Real email delivery. Put these in your own .env (never in this file). Without SMTP_HOST, emails are
# only written to the API console and to GET /api/dev/outbox.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=an-app-password
# SMTP_FROM="CtoC <your-address@gmail.com>"
# Email over the Brevo HTTPS API (use it where SMTP is blocked, e.g. Railway). Takes priority over SMTP_HOST.
# BREVO_API_KEY=your-brevo-api-key
# Sender address, must be verified in Brevo (Senders). Required when BREVO_API_KEY is set.
# MAIL_FROM=sender@example.com
# Sender display name (default: CtoC)
# MAIL_FROM_NAME=CtoC
# Moderator account for `pnpm db:seed` (default email moderator@ctoc.local, dev password "moderator-pass"). Required in production.
# SEED_MODERATOR_EMAIL=moderator@ctoc.local
# SEED_MODERATOR_PASSWORD=choose-a-password

# --- Web ---
WEB_PORT=5173
# Where the Vite dev server proxies /api to (default: http://localhost:$PORT)
# API_URL=http://localhost:3001
# Base URL of the API as seen by the browser
VITE_API_BASE_URL=/api
# Where story links in the page stubs point to
VITE_DOCS_BASE_URL=https://github.com/arinakhmel/CtoC/blob/main/docs
